{
  "name": "@ghostcart/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @ghostcart/widget run build && next dev",
    "build": "pnpm --filter @ghostcart/widget run build && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "db:backfill": "tsx --env-file-if-exists=.env.local scripts/backfill-postgres.mts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.87",
    "@electric-sql/pglite": "0.5.8",
    "@ghostcart/core": "workspace:*",
    "@ghostcart/db": "workspace:*",
    "@mendable/firecrawl-js": "^4.51.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@upstash/redis": "^1.39.0",
    "@vercel/blob": "2.8.1",
    "ai": "^7.0.152",
    "drizzle-orm": "0.45.4",
    "mcp-handler": "2.3.0",
    "next": "16.4.3",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ghostcart/widget": "workspace:*",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
