# --- AI (Vercel AI SDK) ---
ANTHROPIC_API_KEY=
GHOSTCART_MODEL=claude-sonnet-5-5

# --- Payments: Pine Labs Online (Plural) ---
PINELABS_BASE_URL=https://pluraluat.v2.pinepg.in
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=
PINELABS_WEBHOOK_SECRET=

# --- Storage: Upstash Redis (injected by Vercel's Upstash integration) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Storage: Neon Postgres (injected by Vercel's Neon integration) ---
DATABASE_URL=
# Direct (unpooled) URL, used by migrations
DATABASE_URL_UNPOOLED=
# redis (default) | dual (write both, read Redis) | postgres. See docs/database.md
STORE_MODE=redis

# --- Deal rules ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEAL_TTL_SECONDS=180
DEAL_LOCK_FEE_INR=9
DEAL_MAX_DISCOUNT_INR=1000
# After the lock fee: minutes to add a delivery address and pay the balance; estimated delivery days
CHECKOUT_WINDOW_MINUTES=30
DELIVERY_DAYS=3

# Staff who can open /admin and /userloggedin, logging in with a phone code.
# Comma-separated number:role:name; roles are owner, approver (decisions, orders, raw logs) and viewer (analytics only).
STAFF=9876543210:owner:Your Name
# Deprecated service token for scripts (production E2E check). Every use is audited as "Service token".
ADMIN_TOKEN=

# --- Voice approvals: Vobiz (agent phones the seller / deal desk) ---
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
# Caller ID: a number you own on Vobiz, E.164 digits (e.g. 9180XXXXXXXX)
VOBIZ_FROM_NUMBER=
# Speech + TTS language for calls (en-US is Vobiz's default; try en-IN if your account supports it)
VOBIZ_LANGUAGE=en-US
# Optional: teammate's mobile to call for GhostCart-funded escalations
VOBIZ_DESK_PHONE=
# Optional: secret for signing voice callback URLs (defaults to ADMIN_TOKEN)
VOBIZ_WEBHOOK_SECRET=

# Bearer token the AgenticOrg connector sends to /api/mcp
MCP_TOKEN=

# --- AgenticOrg deal-desk agent (reviews escalations via our /api/mcp tools) ---
AGENTICORG_BASE_URL=https://agenticorg.hackathon.pinelabs.com
AGENTICORG_AGENT_ID=
# Either an API key (admin accounts) ...
AGENTICORG_API_KEY=
# ... or the team's developer login (hackathon tenant)
AGENTICORG_EMAIL=
AGENTICORG_PASSWORD=

# Pine Labs test gateway (no money moves) for development and previews without UAT keys: set
# PINELABS_MODE=mock, PINELABS_BASE_URL=<app url>/api/mock-pinelabs, and any non-empty client id/secret.
# The production deployment refuses it unless ALLOW_TEST_PAYMENTS=1; deals are then labelled test mode.
PINELABS_MODE=
ALLOW_TEST_PAYMENTS=

# --- Seller verification ---
# KYC provider for PAN, GSTIN and bank (penny-drop) checks. Unset in production = "manual" (a reviewer checks
# documents); "sandbox" works only outside production. A contracted provider adapter plugs in here.
KYC_PROVIDER=
# Keyed hash for spotting a PAN or bank account reused across seller accounts (required in deployments)
IDENTITY_HASH_SECRET=
# Vercel Blob token for product photos and verification uploads (local dev writes to public/uploads)
BLOB_READ_WRITE_TOKEN=

# --- Orders and payouts ---
# Settlement gateway that holds the seller's share until delivery. Unset = mock where test payments are allowed;
# production stays closed for shop checkout until the Pine Labs split/hold adapter exists (partner agreement).
SETTLEMENT_PROVIDER=
# GhostCart fee in basis points of the order value (200 = 2%); 18% GST is added on the fee
PLATFORM_FEE_BPS=200
# Hours a seller has to ship before the order is cancelled and refunded
SHIP_SLA_HOURS=48
# Shared secret Vercel Cron sends to /api/cron/orders
CRON_SECRET=
# Courier tracking through Shiprocket (confirms delivery for payout release). Without it, delivery is
# confirmed by the buyer's handover code or "I received it"; development uses a mock tracker.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# --- Integrations ---
# Encrypts secrets GhostCart must read back (webhook signing secrets). Required in deployments.
SECRETS_KEY=
# Minutes a Shopify/WooCommerce price-grant code stays valid
GRANT_MINUTES=30

# --- Shopify app (apps/shopify; values from the Shopify Partner dashboard) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_discounts,read_orders
SHOPIFY_API_VERSION=2026-07
# on = charge GhostCart's fee as Shopify usage records (merchant approves a capped subscription once)
SHOPIFY_BILLING=
# Development only: point at the in-repo mock, e.g. http://localhost:3000/api/mock-shopify
SHOPIFY_ADMIN_BASE=
# 1 = keep email/phone from Shopify checkouts whose shopper accepted the store's marketing (GhostCart
# Privilege invites). Leave empty until Protected Customer Data access is granted and legal signs off.
SHOPIFY_CHECKOUT_CONTACT=

# --- Amazon Seller Central (SP-API), for importing a seller's own listings ---
AMAZON_SPAPI_APP_ID=
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
# off once the SP-API app is published (draft apps add version=beta to the consent link)
AMAZON_SPAPI_DRAFT=
# Development only: point all three at the in-repo mock, e.g. http://localhost:3000/api/mock-amazon
AMAZON_CONSENT_BASE=
AMAZON_LWA_BASE=
AMAZON_SPAPI_BASE=

# --- Meta: WhatsApp Cloud API (and Instagram Messaging next), from the Meta developer dashboard ---
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v24.0
# WhatsApp Embedded Signup (Facebook Login for Business configuration)
META_WA_CONFIG_ID=
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_WA_CONFIG_ID=
# Development only: the in-repo Graph mock, and a "connect a test number" button
META_GRAPH_BASE=
NEXT_PUBLIC_META_DEV_MOCK=

# --- Price comparison (official affiliate programmes only; no scraping, no cashback) ---
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PARTNER_TAG=
# Development only: sample comparison results without affiliate accounts
AFFILIATE_MOCK=

# --- Grievance officer (DPDP Act, Consumer Protection (E-Commerce) Rules), shown on /grievance ---
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=

# Staging only, for k6 load tests (load/README.md): IPs exempt from rate limits. Ignored on Vercel production.
RATE_LIMIT_ALLOWLIST=

# --- ONDC buyer app (from registry onboarding: staging, then pre-prod, then production) ---
# Generate keys with ONDC's key utility (Ed25519 signing as base64 raw keys; X25519 encryption as base64 DER).
ONDC_SUBSCRIBER_ID=
ONDC_UNIQUE_KEY_ID=
# Our callback base, https://<app>/api/ondc; the registry and gateway base URLs for the environment.
ONDC_BAP_URI=
ONDC_REGISTRY_URL=
ONDC_GATEWAY_URL=
ONDC_SIGNING_PRIVATE_KEY=
ONDC_SIGNING_PUBLIC_KEY=
ONDC_ENCRYPTION_PRIVATE_KEY=
ONDC_REGISTRY_ENCRYPTION_PUBLIC_KEY=
# The request_id from the subscribe form; /ondc-site-verification.html serves it signed.
ONDC_SITE_REQUEST_ID=
ONDC_DOMAIN=ONDC:RET10
ONDC_CITY=std:080
# Development: point ONDC_REGISTRY_URL and ONDC_GATEWAY_URL at <app>/api/mock-ondc/registry and /gateway.

# --- Mobile app push (Expo) ---
# Only if "enhanced push security" is on in the Expo project. EXPO_PUSH_URL is for development, pointing at the mock.
EXPO_ACCESS_TOKEN=
EXPO_PUSH_URL=
# Development only: the Expo web preview's origin, allowed by CORS (e.g. http://localhost:8081)
MOBILE_DEV_ORIGIN=

# --- Observability (docs/observability.md); all optional ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
# OpenTelemetry export outside Vercel, e.g. Axiom: https://api.axiom.co and "Authorization=Bearer <token>,X-Axiom-Dataset=<dataset>"
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
POSTHOG_KEY=
POSTHOG_HOST=

# --- Cloudflare Turnstile in front of login/signup code calls (optional; Cloudflare's test keys work in dev) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Browser push for sellers' approvals (npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@ghostcart.app

# --- GhostCart's details on monthly fee invoices (lib/invoices.ts); confirm SAC and state with the CA ---
GHOSTCART_LEGAL_NAME=
GHOSTCART_GSTIN=
GHOSTCART_ADDRESS=
GHOSTCART_STATE_CODE=29
GHOSTCART_SAC=998599

# --- Flipkart Marketplace Seller APIs (app approval needed; dev uses the in-repo mock) ---
FLIPKART_APP_ID=
FLIPKART_APP_SECRET=
# Development only: <app>/api/mock-flipkart/oauth-service and <app>/api/mock-flipkart/sellers
FLIPKART_AUTH_BASE=
FLIPKART_API_BASE=

# --- WhatsApp through a BSP (Gupshup), per seller from the dashboard; development points at the mock ---
GUPSHUP_API_BASE=

# --- GhostCart Privilege: private offers on abandoned carts (docs/plans/ghostcart-privilege.md) ---
# Email through Resend. Without a key, development keeps messages in an outbox; production refuses to send.
RESEND_API_KEY=
EMAIL_FROM=GhostCart <offers@ghostcart.app>
# Default WhatsApp template name for the invite (a seller's number can override it); approved per number by Meta.
WHATSAPP_PRIVILEGE_TEMPLATE=
WHATSAPP_PRIVILEGE_TEMPLATE_LANG=en
# 1 = allow invite calls through Vobiz. Leave empty until TRAI rules for these calls are confirmed with Vobiz.
PRIVILEGE_VOICE_CALLS=

# --- Envelope encryption for stored secrets (lib/crypto.ts). Key-encryption keys: id:<base64 of 32 bytes>, newest first.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SECRETS_KEY (above, if set) keeps working as key "k0" so existing values stay readable.
SECRETS_KEYS=
SECRETS_KEY_ID=
